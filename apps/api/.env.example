# Puerto del servidor NestJS
PORT=3001

# URL del frontend, para configurar CORS
FRONTEND_URL=http://localhost:3002

# Postgres de Supabase — botón "Connect" en el dashboard > pestaña ORMs > Prisma
# La conexión directa (db.[project-ref].supabase.co) suele ser IPv6-only y puede
# no ser alcanzable desde redes sin salida IPv6 — por eso usamos el pooler (IPv4) para ambas.
DATABASE_URL="postgresql://postgres.[project-ref]:[password-url-encoded]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password-url-encoded]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Project URL — Project Settings > API
# Se usa para construir la URL del JWKS (https://[project-ref].supabase.co/auth/v1/.well-known/jwks.json)
# con el que NestJS verifica los JWT que emite Supabase Auth (llaves de firma ES256/ECC).
SUPABASE_URL=https://[project-ref].supabase.co

# OAuth 2.1 / servidor MCP
# Issuer del Authorization Server. Sin path (así la URL de metadata no cae en
# el laberinto de path-insertion de RFC 8414). Debe ser resoluble por
# clientes externos, no localhost, en producción.
OAUTH_ISSUER=http://localhost:3001

# URI canónica del recurso MCP (RFC 8707) — a qué recurso queda "atado" cada
# access token. Debe apuntar al endpoint real que sirve el servidor MCP.
MCP_PUBLIC_URL=http://localhost:3001/mcp

# A dónde redirige /oauth/authorize para que el usuario apruebe o rechace la
# conexión — la pantalla de consentimiento vive en apps/web.
MCP_CONSENT_URL=http://localhost:3002/oauth/consent
